    "settings.autoshow.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在某个 App 里用 OpenInput 成功插入过文本后，下次在该 App 的输入框聚焦时会自动打开小窗；若你主动关闭（esc / ✕），则不再自动打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
